AddDefaultCharset utf-8

RewriteEngine On

# Прямые HTTP-запросы к коду приложения, CLI-утилитам и приватным данным
# запрещены: код подключается только с файловой системы (index.php и php-cli),
# а в _private лежат логи, которые наружу отдавать нельзя. На боевом сервере
# _private закрыт ещё и на уровне nginx — здесь дублируем на уровне приложения,
# чтобы защита не зависела от настроек конкретной установки.
# Правило должно оставаться выше RewriteCond ниже — те относятся к правилу
# маршрутизации, и вставка между ними её сломает.
RewriteRule ^(_private|lpm-cli|lpm-core)/ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME} -f
#RewriteRule .* - [L]

#RewriteRule ^([a-zA-Z_0-9\-]+)?\/?([a-zA-Z_0-9\-]+)?\/?([a-zA-Z_0-9\-]+)?\/?([a-zA-Z_0-9\-]+)?\/?([a-zA-Z_0-9\-]+)?/?[^\.]*$ index.php?args[]=$1&args[]=$2&args[]=$3&args[]=$4&args[]=$5
#RewriteRule ^([a-zA-Z_0-9\-/]+)?(\?[&a-zA-Z_0-9=%,.-]+)?(#.*)?$ index.php?route=$1&args=$2&args1=$3
RewriteRule ^([a-zA-Z_0-9\-/]+)?(/.*)?$ index.php?route=$1&%{QUERY_STRING}

RewriteRule ^[a-zA-Z/\_0-9/\-]{0,}(lpm\-libs/flash2php/gateway\.php){1}$ $1
#RewriteRule ^[a-zA-Z/\_0-9/\-]{0,}(_private/.*)$ $1

# --- Static asset compression & caching ---
# CSS/JS are versioned via a ?<hash> query param (PageConstructor::_versionParam),
# so they are safe to cache far-future; the hash changes on each release.

<IfModule mod_mime.c>
	# Serve JS (incl. ES modules) with a JS MIME type so module loading works
	AddType text/javascript .js .mjs
	AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE \
		text/html text/plain text/xml text/css \
		text/javascript application/javascript application/x-javascript \
		application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	# Versioned assets (cache-busted on release)
	ExpiresByType text/css               "access plus 1 year"
	ExpiresByType text/javascript        "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	# Fonts
	ExpiresByType font/woff2             "access plus 1 year"
	ExpiresByType font/woff              "access plus 1 year"
	ExpiresByType application/font-woff  "access plus 1 year"
	ExpiresByType font/ttf               "access plus 1 year"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
	# Images (not query-versioned) — shorter horizon
	ExpiresByType image/svg+xml          "access plus 1 month"
	ExpiresByType image/png              "access plus 1 month"
	ExpiresByType image/jpeg             "access plus 1 month"
	ExpiresByType image/gif              "access plus 1 month"
	ExpiresByType image/webp             "access plus 1 month"
	ExpiresByType image/x-icon           "access plus 1 week"
</IfModule>